# Server-only configuration. Do not prefix secrets with VITE_.
GEMINI_API_KEY=
# Explicit low-cost profile. A blank value uses this default.
GEMINI_MODEL=gemini-3.1-flash-lite
# Local estimate guard, not a billing-account cap (0 < value <= 1).
AI_DAILY_BUDGET_USD=1
AI_USAGE_LEDGER_PATH=.local/ai-usage.json
# Keep false until a live sample verifies candidate/thinking billing accounting.
AI_COST_RECONCILIATION_VERIFIED=false
